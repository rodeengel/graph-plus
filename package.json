{
  "name": "graph-plus-semantic",
  "version": "0.2.0-semantic.2a",
  "description": "Obsidian semantic graph with typed relationship appearance and physics",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^20.11.0",
    "@types/three": "^0.183.1",
    "builtin-modules": "^3.3.0",
    "esbuild": "0.25.0",
    "obsidian": "latest",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "3d-force-graph": "^1.73.0",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-force-3d": "^3.0.6",
    "d3-scale": "^4.0.0",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "three": "^0.183.2"
  }
